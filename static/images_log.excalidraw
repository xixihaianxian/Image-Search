      "link": null,
      "locked": false,
      "text": "create table images(\n    id integer primary key ,\n    folder_id integer not null ,\n    -- 原始图片地址\n    path varchar(300) not null unique ,\n    -- 原始图片名称\n    name varchar(100) not null  ,\n    -- 图片拓展名\n    extension varchar(50) not null ,\n    -- 缩略图存放的路径\n    thumbnail_path varchar(300) not null unique ,\n    created_at datetime default current_timestamp,\n    updated_at datetime default current_timestamp,\n    constraint folders_images_folder_id foreign key (folder_id)\nreferences folders(id) on delete cascade on update cascade\n);\n\ncreate index index_name on images(name);\n\ncreate index index_folder_index on images(folder_id);",
      "fontSize": 15.262791411320933,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "Fp6XNY-LcNFj-e1ZjVm6y",
      "originalText": "create table images(\n    id integer primary key ,\n    folder_id integer not null ,\n    -- 原始图片地址\n    path varchar(300) not null unique ,\n    -- 原始图片名称\n    name varchar(100) not null  ,\n    -- 图片拓展名\n    extension varchar(50) not null ,\n    -- 缩略图存放的路径\n    thumbnail_path varchar(300) not null unique ,\n    created_at datetime default current_timestamp,\n    updated_at datetime default current_timestamp,\n    constraint folders_images_folder_id foreign key (folder_id) references folders(id) on delete cascade on update cascade\n);\n\ncreate index index_name on images(name);\n\ncreate index index_folder_index on images(folder_id);",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
